{
  "name": "tupay",
  "version": "1.0.0",
  "description": "Tupay: fútbol de tapitas por turnos con equipos de la Liga boliviana",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:client": "vite",
    "dev:server": "tsx watch server/src/index.ts",
    "build": "npm run build:client && npm run build:server",
    "build:client": "vite build",
    "build:server": "tsc -p server",
    "start": "node dist/server/src/index.js",
    "lint": "npm run lint:client && npm run lint:server",
    "lint:client": "eslint client compartido vite.config.ts",
    "lint:server": "eslint server scripts",
    "typecheck": "tsc -p . && tsc -p client && tsc -p server --noEmit"
  },
  "dependencies": {
    "express": "^5.2.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/express": "^5.0.6",
    "@types/node": "^22.20.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^10.10.0",
    "globals": "^17.12.0",
    "tsx": "^4.23.13",
    "typescript": "~5.9",
    "typescript-eslint": "^8.70.0",
    "vite": "^8.3.0"
  }
}
